{
  "version": 2,
  "outputDirectory": "front-end/dist",
  "builds": [
    {
      "src": "back-end/dist/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "back-end/dist/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "back-end/dist/server.js"
    }
  ]
}
